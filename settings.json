{
	"breadcrumbs.enabled": true,
	// Deve instalar a fonte
	"editor.fontFamily": "JetBrains Mono",
	"editor.fontSize": 13,
	"editor.lineHeight": 1.6,
	"editor.fontVariations": false,
	"editor.autoClosingDelete": "always",
	"editor.parameterHints.enabled": false,
	"editor.suggestSelection": "first",
	"editor.fontLigatures": true,
	"editor.minimap.enabled": false,
	"editor.autoClosingBrackets": "always",
	"editor.autoClosingQuotes": "always",
	"editor.renderWhitespace": "trailing",
	"editor.renderLineHighlight": "gutter",
	"editor.bracketPairColorization.enabled": false,
	"editor.codeLens": false,
	"editor.accessibilitySupport": "off",
	"editor.semanticHighlighting.enabled": false,
	"editor.tabSize": 2,
	"prettier.printWidth": 90,
	"prettier.proseWrap": "never",
	"prettier.singleQuote": true,
	"prettier.useTabs": true,
	"errorLens.fontSize": "10px",
	"errorLens.fontWeight": "700",
	"errorLens.messageBackgroundMode": "message",
	"errorLens.padding": "1px",
	"inline-parameters.fontWeight": "700",
	"inline-parameters.fontStyle": "normal",
	"inline-parameters.fontSize": "10px",
	"inline-parameters.padding": "1px",
	"explorer.compactFolders": false,
	"extensions.ignoreRecommendations": true,
	"git.openRepositoryInParentFolders": "always",
	"gitlens.codeLens.recentChange.enabled": false,
	"gitlens.hovers.autolinks.enabled": false,
	"gitlens.codeLens.authors.enabled": false,
	"gitlens.codeLens.enabled": false,
	"gitlens.hovers.avatars": false,
	"gitlens.views.stashes.files.layout": "tree",
	"gitlens.blame.avatars": false,
	"gitlens.heatmap.locations": ["gutter", "overview"],
	"gitlens.statusBar.enabled": false,
	"gitlens.hovers.pullRequests.enabled": false,
	"gitlens.gitCommands.skipConfirmations": ["fetch:command", "switch:command"],
	"javascript.suggest.autoImports": true,
	"javascript.updateImportsOnFileMove.enabled": "always",
	"typescript.updateImportsOnFileMove.enabled": "always",
	"typescript.suggest.autoImports": true,
	"terminal.integrated.fontSize": 12,
	"terminal.integrated.fontFamily": "JetBrains Mono, Monaco, 'Courier New', monospace",
	"terminal.integrated.defaultProfile.windows": "Git Bash",
	"turboConsoleLog.delimiterInsideMessage": "",
	"turboConsoleLog.insertEnclosingClass": false,
	"turboConsoleLog.insertEnclosingFunction": false,
	"turboConsoleLog.logMessagePrefix": "%c",
	"turboConsoleLog.logMessageSuffix": "', 'font-weight: bold; text-transform: uppercase; color: #50fa7b",
	"turboConsoleLog.quote": "'",
	"[typescript]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},
	"[html]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},
	"[scss]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},
	"[css]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},
	"[javascript]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},
	"[typescriptreact]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},
	"[json]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},
	"[jsonc]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},
	"window.commandCenter": false,
	"workbench.layoutControl.enabled": false,
	"workbench.editor.labelFormat": "short",
	"workbench.tree.indent": 12,
	"workbench.iconTheme": "material-icon-theme",
	"workbench.colorCustomizations": {},
	"workbench.startupEditor": "newUntitledFile",
	"workbench.sideBar.location": "right",
	"workbench.activityBar.location": "top",
	"editor.unicodeHighlight.allowedCharacters": {
		" ": true
	},
	"editor.inlineSuggest.suppressSuggestions": true,
	"editor.codeActionsOnSave": {
		"source.fixAll.eslint": "explicit"
	},
	"[prisma]": { "editor.formatOnSave": true },
	"files.autoSave": "afterDelay",
	"liveServer.settings.donotShowInfoMsg": true,
	"window.customTitleBarVisibility": "auto",
	"explorer.confirmDragAndDrop": false,
	"security.workspace.trust.untrustedFiles": "open",
	"eslint.useFlatConfig": false,
	"redhat.telemetry.enabled": true,
	"workbench.colorTheme": "Omni Dracula Theme Contrast",
	"editor.indentSize": "tabSize",

	"java.configuration.runtimes": [
		{
			"name": "JavaSE-21",
			"path": "/usr/lib/jvm/java-21-openjdk-amd64",
			"default": true
		}
	],
	"editor.linkedEditing": true,
	"editor.rulers": [
		{
			"column": 80,
			"color": "#00FF0010"
		},
		{
			"column": 100,
			"color": "#BDB76B15"
		},
		{
			"column": 120,
			"color": "#FA807219"
		}
	],
	"editor.unicodeHighlight.includeComments": true,
	"workbench.editor.revealIfOpen": true,
	"emmet.variables": {
		"lang": "en"
	},
	"cSpell.diagnosticLevel": "Hint",
	"trailing-spaces.backgroundColor": "rgba(255,0,0,0.1)",
	"trailing-spaces.includeEmptyLines": false,
	"terminal.integrated.tabs.hideCondition": "never",
	"terminal.integrated.enablePersistentSessions": false,
	"java.compile.nullAnalysis.mode": "automatic",
	"java.configuration.detectJdksAtStart": false,
	"java.configuration.updateBuildConfiguration": "automatic",
	"java.debug.settings.hotCodeReplace": "auto",
	"java.dependency.packagePresentation": "hierarchical",
	"java.maxConcurrentBuilds": 12,
	"java.sources.organizeImports.staticStarThreshold": 1,
	"terminal.integrated.profiles.linux": {
		"bash": {
			"path": "bash",
			"env": {
				"JAVA_HOME": "/usr/lib/jvm/java-21-openjdk-amd64"
			},
			"args": [
				"--rcfile",
				"/home/fernanda/.config/Code/User/globalStorage/pleiades.java-extension-pack-jdk/.bashrc"
			]
		},
		"JavaSE-21 LTS": {
			"overrideName": true,
			"env": {
				"JAVA_HOME": "/usr/lib/jvm/java-21-openjdk-amd64"
			},
			"path": "bash",
			"args": [
				"--rcfile",
				"/home/fernanda/.config/Code/User/globalStorage/pleiades.java-extension-pack-jdk/.bashrc"
			]
		}
	},
	"terminal.integrated.defaultProfile.linux": "JavaSE-21 LTS",
	"maven.terminal.customEnv": [
		{
			"environmentVariable": "JAVA_HOME",
			"value": "/usr/lib/jvm/java-21-openjdk-amd64"
		}
	],
	"java.import.gradle.java.home": "/usr/lib/jvm/java-21-openjdk-amd64",
	"maven.executable.path": "/home/fernanda/.config/Code/User/globalStorage/pleiades.java-extension-pack-jdk/maven/latest/bin/mvn",
	"java.import.gradle.home": "/home/fernanda/.config/Code/User/globalStorage/pleiades.java-extension-pack-jdk/gradle/latest"
}
